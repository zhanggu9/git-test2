# 로컬에서 `uvicorn app.backend.main:app --reload`로 실행할 때 사용하는 예시입니다.
# Docker Compose 환경에서는 compose 파일에서 기본값을 지정하며, 외부 API 키는 저장소 루트 .env에서 보완할 수 있습니다.

# 퀴즈 저장소(MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=investment_db

# 학습 문서 검색(Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=investment_docs

# 경량 RAG(Qdrant + hashing-384)는 별도 임베딩 모델이 필요하지 않습니다.
# Qdrant는 로컬 실행 시 localhost:6333, Docker Compose에서는 compose가 설정합니다.

# 외부 AI 요약을 사용할 때만 설정합니다. OpenAI 호환 /v1/chat/completions 엔드포인트를 지원해야 합니다.
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
RAG_LLM_TIMEOUT_SECONDS=180

# OpenDART 기업·재무 공시 조회용 인증키 (미설정 시 DART API는 503을 반환)
DART_API_KEY=

